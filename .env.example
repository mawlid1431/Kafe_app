# Copy to .env.local and fill in values (never commit .env.local)

# Expo
EXPO_USE_BUN=1
EAS_PROJECT_ID=

# Kafe Eman API (NestJS) — see backend/.env.example for the server side.
# Mobile: use your PC's LAN IP so a physical phone can reach it, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.0.152:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
VITE_API_URL=http://localhost:4000/api

# Clerk — dashboard.clerk.com -> API Keys (Native application)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER_DOMAIN=https://YOUR-INSTANCE.clerk.accounts.dev
CLERK_FRONTEND_API_URL=https://YOUR-INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Name of the Clerk JWT template the app requests a token from. Must match
# CLERK_JWT_AUDIENCE in backend/.env — change one and you must change the other.
EXPO_PUBLIC_CLERK_JWT_TEMPLATE=kafeeman

# Google Maps — Android only (iOS uses Apple Maps and needs no key).
# console.cloud.google.com -> APIs & Services -> Credentials -> Create API key,
# then enable "Maps SDK for Android". Leave empty and the Android map is grey.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Running the stack ────────────────────────────────────────────────
# Everything:  bun run dev     (API + Expo QR + admin dashboard)
#   Mobile  -> scan QR in terminal (Expo Go)
#   Admin   -> http://localhost:5173/login
#   API     -> http://localhost:4000/api
# Individually: bun run api | bun run app | bun run admin
#
# Database (backend/.env holds DATABASE_URL etc.):
#   bun run db:migrate   apply Prisma migrations to Neon
#   bun run db:seed      branches, menu, promos + default admin
#   bun run db:studio    browse the data
# Default admin login: admin / admin123
#
# If Expo Go times out on LAN, set your PC Wi-Fi IPv4 (ipconfig):
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.0.152
