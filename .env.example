# Copy to .env.local and fill in values (never commit .env.local)

# Expo
EXPO_USE_BUN=1
EAS_PROJECT_ID=

# Clerk — dashboard.clerk.com → API Keys (Native application)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Google Maps — Android only (iOS uses Apple Maps and needs no key).
# console.cloud.google.com → APIs & Services → Credentials → Create API key,
# then enable "Maps SDK for Android". Leave empty and the Android map is grey.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Convex — from dashboard.convex.dev or `bun run convex:dev`
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=

# Convex dashboard only (not .env.local) — JWT template name must be "convex":
#   bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://YOUR-INSTANCE.clerk.accounts.dev

# Start both mobile app + admin: bun run dev
#   Mobile  → scan QR in terminal (Expo Go)
#   Admin   → http://localhost:5173/login
# App only: bun run app   |   Admin only: bun run admin
# If Expo Go times out on LAN, set your PC Wi‑Fi IPv4 (ipconfig):
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.0.152
# Seed Convex + default admin: bun run convex:seed
# Default login: admin / admin123
