# Copy to .env and fill in. Never commit .env.

# ── Neon PostgreSQL ────────────────────────────────────────────────
# DATABASE_URL  → pooled connection (host contains "-pooler"), used at runtime
# DIRECT_URL    → direct connection (same host WITHOUT "-pooler"), used by prisma migrate
DATABASE_URL=
DIRECT_URL=

# ── Server ─────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated. 5173 = admin dashboard (Vite), 8081 = Expo dev server.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ── Clerk (customer auth) ──────────────────────────────────────────
# Same instance the mobile app uses. See ../.env.example
CLERK_JWT_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Must equal EXPO_PUBLIC_CLERK_JWT_TEMPLATE in ../.env.local
CLERK_JWT_AUDIENCE=kafeeman

# ── Cloudinary (image storage) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kafe-eman

# ── Admin auth ─────────────────────────────────────────────────────
ADMIN_SESSION_TTL_DAYS=7
# Used by `bun run seed` to create the first superadmin.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# ── Groq ───────────────────────────────────────────────────────────
# Reserved for a planned AI feature. Nothing uses it yet.
GROQ_API_KEY=
