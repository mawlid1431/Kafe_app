// Kafe Eman — relational schema.
//
// Design notes:
//  • Order line items live in their own table, enabling per-item reporting.
//  • Menu categories are a table, not a free-text column.
//  • Branch references are real foreign keys, not slug strings.
//  • Snapshot columns (Order.branchLabel, Order.promoCode, OrderItem.name/price)
//    are denormalised ON PURPOSE: a historical receipt must not change when an
//    admin renames a branch, edits a price or deletes a promo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPERADMIN
  STAFF
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum PayMethod {
  TNG
  CARD
  BANKING
}

enum OrderStatus {
  ACTIVE
  DELIVERED
  CANCELLED
}

/// App customer. Identity is owned by Clerk; this row is the local projection.
model User {
  id         String   @id @default(uuid())
  /// Clerk user id (the JWT `sub` claim).
  clerkId    String   @unique
  email      String   @unique
  name       String
  pictureUrl String?
  points     Int      @default(0)
  suspended  Boolean  @default(false)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@index([branchId])
  @@map("users")
}

/// Dashboard operator. Completely separate identity space from User.
model Admin {
  id           String         @id @default(uuid())
  username     String         @unique
  passwordHash String
  passwordSalt String
  displayName  String
  email        String
  role         AdminRole      @default(STAFF)
  active       Boolean        @default(true)
  sessions     AdminSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("admins")
}

/// Opaque bearer token, stored only as a SHA-256 hash.
model AdminSession {
  id        String   @id @default(uuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Branch {
  id            String   @id @default(uuid())
  slug          String   @unique
  label         String
  address       String
  hours         String
  imageUrl      String?
  /// Cloudinary public_id — needed to destroy the asset on replace/delete.
  imagePublicId String?
  lat           Float
  lng           Float
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  users         User[]
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
  @@map("branches")
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  sortOrder Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sortOrder])
  @@map("categories")
}

model MenuItem {
  id            String      @id @default(uuid())
  /// Numeric id the mobile app matches cart lines and favourites on. Kept.
  legacyId      Int?        @unique
  name          String
  description   String      @default("")
  price         Decimal     @db.Decimal(10, 2)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  imageUrl      String
  imagePublicId String?
  rating        Float?
  calories      Int?
  badge         String?
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([categoryId, sortOrder])
  @@index([sortOrder])
  @@map("menu_items")
}

model Promo {
  id              String   @id @default(uuid())
  /// Always stored uppercase.
  code            String   @unique
  title           String
  subtitle        String   @default("")
  imageUrl        String?
  imagePublicId   String?
  discountPercent Int?
  fixedOff        Decimal? @db.Decimal(10, 2)
  minSpend        Decimal? @db.Decimal(10, 2)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sortOrder])
  @@map("promos")
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId     String?
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// Snapshot — survives a branch rename or deletion.
  branchLabel  String
  orderType    OrderType
  payMethod    PayMethod
  status       OrderStatus @default(ACTIVE)
  trackingStep Int         @default(0)
  items        OrderItem[]

  subtotal    Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  promoId        String?
  promo          Promo?  @relation(fields: [promoId], references: [id], onDelete: SetNull)
  /// Snapshot — survives promo deletion.
  promoCode      String?
  pointsEarned   Int     @default(0)
  pointsRedeemed Int     @default(0)
  orderNote      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([branchId, createdAt])
  @@index([createdAt])
  @@index([promoId])
  @@map("orders")
}

model OrderItem {
  id         String    @id @default(uuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  /// Snapshot of MenuItem.legacyId — what the mobile app reads.
  legacyMenuItemId Int?
  /// Snapshot of MenuItem.name at purchase time.
  name             String
  /// Snapshot of MenuItem.price at purchase time.
  price            Decimal @db.Decimal(10, 2)
  qty              Int
  sugar            String?
  ice              String?

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}
