{
  "name": "kafeeman-backend",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "author": "Mawlid Mohamud (Malitos) <malitmohamud@gmail.com> (https://github.com/mawlid1431)",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.1.0"
  },
  "type": "commonjs",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bunx tsc -p tsconfig.build.json",
    "typecheck": "bunx tsc --noEmit",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:deploy": "bunx prisma migrate deploy",
    "prisma:push": "bunx prisma db push",
    "prisma:studio": "bunx prisma studio",
    "seed": "bun prisma/seed.ts",
    "test:e2e": "bun test/e2e-verify.ts",
    "test:orders": "bun test/orders-verify.ts",
    "test:all": "bun test/e2e-verify.ts && bun test/orders-verify.ts"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.7.0",
    "jose": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.21",
    "only-allow": "^1.2.2",
    "prisma": "^6.16.2",
    "typescript": "~5.9.3"
  }
}
